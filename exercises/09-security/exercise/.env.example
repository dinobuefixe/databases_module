# Copy to .env (gitignored) and fill in the real passwords. The API reads only
# these variables; nothing is hardcoded in the code.

# PostgreSQL: the least-privilege application role created by roles.sql.
EX09_PG_DSN=postgresql://ex09_app:CHANGE_ME@localhost:5432/ex09

# MongoDB: user ex09_app with the readWrite role on the ex09 database.
EX09_MONGO_URL=mongodb://ex09_app:CHANGE_ME@localhost:27017/ex09?authSource=ex09

# Redis: ACL user ex09_app.
EX09_REDIS_URL=redis://ex09_app:CHANGE_ME@localhost:6379/0
